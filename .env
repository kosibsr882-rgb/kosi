services:
  - type: web
    name: fast-mailer
    env: node
    plan: free
    buildCommand: "npm install"
    startCommand: "node server.js"
    envVars:
      - key: ADMIN_USER
        value: admin
      - key: ADMIN_PASS
        value: admin123
      - key: SESSION_SECRET
        value: yourStrongSecret
      - key: PORT
        value: 3000
